# Copy to .env and fill in. Run with: npm run start:env
PORT=3000
API_KEY=change-me

# CloudConvert (first engine). Leave empty to use only LibreOffice.
CLOUDCONVERT_API_KEY=
CLOUDCONVERT_SANDBOX=true

# Optional
# SOFFICE_PATH=/Applications/LibreOffice.app/Contents/MacOS/soffice
# MAX_FILE_MB=25
# MAX_CONCURRENT=2
# CONVERT_TIMEOUT_MS=60000
# CLOUDCONVERT_TIMEOUT_MS=45000
